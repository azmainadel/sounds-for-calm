---
const heroes = [
  '/images/heroes/jade-meadows.webp',
  '/images/heroes/misty-lake.webp',
  '/images/heroes/bengal-river.webp',
];
---

<div aria-hidden="true" class="background">
  <img
    alt=""
    data-heroes={JSON.stringify(heroes)}
    fetchpriority="high"
    width="1672"
    height="941"
  />
  <script is:inline>
    // Pick in the browser, not at build time; only the chosen image is requested.
    (() => {
      const image = document.currentScript.previousElementSibling;
      const heroes = JSON.parse(image.dataset.heroes);
      image.src = heroes[Math.floor(Math.random() * heroes.length)];
    })();
  </script>
  <noscript>
    <img alt="" fetchpriority="high" src={heroes[0]} width="1672" height="941" />
  </noscript>
</div>

<main class="hero">
  <header class="intro">
    <h1 class="title">Sounds for Calm</h1>
    <p class="tagline">Stay here for a while.</p>
  </header>

  <slot />
</main>

<style>
  /* The page is a single, non-scrolling screen; sounds open in dialogs. */
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
    scrollbar-gutter: auto;
  }

  /* Full-screen image behind everything */
  .background {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-color: #0d0f0d;

    & img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;

      &:not([src]) {
        display: none;
      }
    }

    /* Even darkening plus a soft vignette so text and controls stay legible */
    &::after {
      position: absolute;
      inset: 0;
      content: '';
      background:
        radial-gradient(
          ellipse 90% 80% at 50% 45%,
          transparent 30%,
          rgb(0 0 0 / 35%) 100%
        ),
        rgb(0 0 0 / 28%);
    }
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 6svh, 56px);
    align-items: center;
    justify-content: center;
    height: 100svh;
    padding: 72px 0 96px;
    /* Only kicks in on unusually short screens, so nothing is ever cut off */
    overflow-y: auto;
    color: var(--color-on-image);
    text-align: center;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .intro {
    text-shadow: 0 2px 28px rgb(0 0 0 / 35%);
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .tagline {
    margin-top: 14px;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6.5vw, 5.5rem);
    line-height: 1.1;
    text-wrap: balance;
    font-style: italic;
    color: var(--color-on-image-subtle);
  }

  @media (width <= 600px) {
    .hero {
      justify-content: flex-start;
      padding-top: 88px;
    }
  }

  @media (height <= 700px) {
    .hero {
      gap: 24px;
      padding-top: 48px;
    }

    .tagline {
      font-size: clamp(2.5rem, 5vw, 4rem);
    }
  }
</style>
